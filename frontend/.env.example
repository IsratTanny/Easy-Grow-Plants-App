# ─── Easy Grow Plants — Android app build configuration ───
# Copy to ".env" and set the URL of the running Django backend BEFORE building.
# This value is baked into the APK at build time (vite build).
#
# Physical phone (same Wi-Fi as the server device): use the server's LAN IP.
#   Find it on the server device with:  hostname -I        (Linux/macOS)
#   Example:
#     VITE_SERVER_URL=http://192.168.0.42:8000
#
# Android emulator running on the server device: leave unset (defaults to
#   http://10.0.2.2:8000, which maps to the host machine's localhost:8000).

VITE_SERVER_URL=http://192.168.0.42:8000
